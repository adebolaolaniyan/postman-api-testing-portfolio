    {
      "name": "AT01 - Successful Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": "https://dummyjson.com/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"emilys\",\n  \"password\": \"emilyspass\",\n  \"expiresInMins\": 30\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "Public demo credentials for DummyJSON only."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200) });",
              "pm.test(\"Valid JSON\", function () { pm.response.to.be.json });",
              "pm.test(\"Access token exists\", function () { pm.expect(pm.response.json().accessToken).to.be.a('string').and.not.empty });",
              "pm.test(\"Refresh token exists\", function () { pm.expect(pm.response.json().refreshToken).to.be.a('string').and.not.empty });"
            ]
          }
        }
      ]
    },
    {
      "name": "AT02 - Protected Endpoint With Token",
      "request": {
        "method": "GET",
        "header": [],
        "url": "https://dummyjson.com/auth/me",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        },
        "description": "Set collection variable accessToken to the accessToken returned by AT01 before running."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200) });",
              "pm.test(\"Valid JSON\", function () { pm.response.to.be.json });",
              "pm.test(\"User ID exists\", function () { pm.expect(pm.response.json().id).to.exist });",
              "pm.test(\"Username is string\", function () { pm.expect(pm.response.json().username).to.be.a('string') });"
            ]
          }
        }
      ]
    },
