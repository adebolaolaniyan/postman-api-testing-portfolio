    {
      "name": "NT03 - Malformed JSON Behavior",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": "https://httpbin.org/post",
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"not valid\",",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "Records HTTPBin's observed response; it does not prove a server rejects malformed JSON."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTPBin returns 200\", function () { pm.response.to.have.status(200) });",
              "pm.test(\"Valid JSON response\", function () { pm.response.to.be.json });",
              "pm.test(\"Malformed JSON is parsed as null\", function () { pm.expect(pm.response.json().json).to.eql(null) });"
            ]
          }
        }
      ]
    },
