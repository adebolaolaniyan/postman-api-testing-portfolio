  "item": [
    {
      "name": "TC01 - GET Echo Basic Request",
      "request": {
        "method": "GET",
        "header": [],
        "url": "https://httpbin.org/get"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200) });",
              "pm.test(\"Response is valid JSON\", function () { pm.response.to.be.json });",
              "pm.test(\"Response URL contains /get\", function () { pm.expect(pm.response.json().url).to.include(\"/get\") });",
              "pm.test(\"Expected fields exist\", function () { var d=pm.response.json(); pm.expect(d).to.have.property('args'); pm.expect(d).to.have.property('headers'); pm.expect(d).to.have.property('url') });"
            ]
          }
        }
      ]
    },
