    {
      "name": "TC11 - POST JSONPlaceholder Create Post",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": "https://jsonplaceholder.typicode.com/posts",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"API testing portfolio\",\n  \"body\": \"Testing POST request\",\n  \"userId\": 1\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "JSONPlaceholder simulates writes; persistence is not guaranteed."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 201\", function () { pm.response.to.have.status(201) });",
              "pm.test(\"ID exists\", function () { pm.expect(pm.response.json()).to.have.property('id') });",
              "pm.test(\"Title echoed\", function () { pm.expect(pm.response.json().title).to.eql(\"API testing portfolio\") });",
              "pm.test(\"Body echoed\", function () { pm.expect(pm.response.json().body).to.eql(\"Testing POST request\") });",
              "pm.test(\"User ID echoed\", function () { pm.expect(pm.response.json().userId).to.eql(1) });",
              "pm.test(\"Valid JSON\", function () { pm.response.to.be.json });"
            ]
          }
        }
      ]
    },
